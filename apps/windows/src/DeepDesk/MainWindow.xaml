<Window x:Class="DeepDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="/DeepDesk;component/Assets/deepdesk-icon.ico"
        Title="DeepDesk" Height="820" Width="1280" MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#FFFFFF" FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        StateChanged="OnWindowStateChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="TitleBarActionButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinWidth" Value="44"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource TitleBarHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource TitleBarHoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CaptionButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Surface" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource TitleBarHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource TitleBarHoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseCaptionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource CaptionButtonStyle}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Surface" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="WindowSurface" BorderThickness="1" BorderBrush="{DynamicResource WindowBorderBrush}"
          CornerRadius="10" ClipToBounds="True"
          Background="{DynamicResource WindowBackgroundBrush}" SizeChanged="WindowSurface_SizeChanged">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border x:Name="TitleBarSurface" Grid.Row="0" CornerRadius="9,9,0,0"
              Background="{DynamicResource TitleBarBackgroundBrush}"
              BorderBrush="{DynamicResource TitleBarBorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="14,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border x:Name="TitleBarIconBorder" Width="18" Height="18" CornerRadius="4"
                  Background="{DynamicResource TitleBarIconBackgroundBrush}"
                  VerticalAlignment="Center">
            <Image Source="/DeepDesk;component/Assets/deepdesk-logo.png" Stretch="Uniform"
                   Width="18" Height="18"/>
          </Border>

          <TextBlock Grid.Column="1" Text="DeepDesk" Margin="7,0,12,0"
                     FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TitleBarForegroundBrush}"
                     VerticalAlignment="Center"/>

          <Border Grid.Column="2" Width="1" Height="16" VerticalAlignment="Center"
                  Background="{DynamicResource TitleBarBorderBrush}"/>

          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                      Margin="7,0,0,0">
            <Button x:Name="AboutButton" Content="关于" Style="{StaticResource TitleBarActionButton}"
                    Click="About_Click"/>
            <Button x:Name="CheckForUpdatesButton" Content="检查更新"
                    Style="{StaticResource TitleBarActionButton}" Click="CheckForUpdates_Click"/>
          </StackPanel>

          <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"
                      Margin="0,0,0,0">
            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}"
                    Click="Minimize_Click" ToolTip="最小化">
              <Path Data="M 1,6 L 11,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                    StrokeThickness="1.1" StrokeStartLineCap="Square" StrokeEndLineCap="Square"/>
            </Button>
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}"
                    Click="MaximizeRestore_Click" ToolTip="最大化">
              <Grid Width="12" Height="12">
                <Path x:Name="MaximizeNormalGlyph" Data="M 1,1 H 11 V 11 H 1 Z"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      StrokeThickness="1.1" Fill="Transparent"/>
                <Path x:Name="MaximizeRestoreGlyph" Data="M 3,1 H 11 V 9 H 3 Z M 1,3 V 11 H 9"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      StrokeThickness="1.1" Fill="Transparent" Visibility="Collapsed"/>
              </Grid>
            </Button>
            <Button x:Name="CloseWindowButton" Style="{StaticResource CloseCaptionButtonStyle}"
                    Click="CloseWindow_Click" ToolTip="关闭">
              <Path Data="M 2,2 L 10,10 M 10,2 L 2,10"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                    StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <wv2:WebView2 x:Name="Browser" Visibility="Collapsed"/>
        <Grid x:Name="LoadingPanel" Background="{DynamicResource WindowBackgroundBrush}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
            <Image Source="/DeepDesk;component/Assets/deepdesk-logo.png" Width="52" Height="52"
                   Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,14"/>
            <TextBlock Text="DeepDesk" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource TitleBarForegroundBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="正在启动本地 AI 工作空间…" Margin="0,10,0,0" FontSize="12"
                       Foreground="{DynamicResource TitleBarMutedBrush}" HorizontalAlignment="Center"/>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,20,0,0"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
