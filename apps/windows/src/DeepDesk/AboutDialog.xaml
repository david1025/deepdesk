<Window x:Class="DeepDesk.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于 DeepDesk" Icon="/DeepDesk;component/Assets/deepdesk-icon.ico"
        Width="480" Height="226" MinWidth="480" MinHeight="226"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
  <Window.Resources>
    <Style x:Key="CloseButton" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Foreground" Value="#16181D"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontWeight" Value="Light"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#F0F1F3"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#E4E6E9"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ConfirmButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#101114"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#25272B"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#383B41"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="10">
    <Border Background="#FFFFFF" CornerRadius="20">
      <Border.Effect>
        <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.18"/>
      </Border.Effect>
      <Grid Margin="24,21,24,22">
        <Grid.RowDefinitions>
          <RowDefinition Height="26"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <TextBlock Text="DeepDesk" FontSize="17" FontWeight="SemiBold"
                   Foreground="#111318" VerticalAlignment="Center"/>
        <Button Grid.Row="0" Content="×" Style="{StaticResource CloseButton}"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Click="Close_Click" IsCancel="True"/>

        <TextBlock x:Name="VersionText" Grid.Row="1"
                   FontSize="13" FontWeight="Normal" Foreground="#50545D"
                   Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Text, ElementName=VersionText}"/>
        <Button Grid.Row="3" Content="确定" Style="{StaticResource ConfirmButton}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Click="Close_Click" IsDefault="True"/>
      </Grid>
    </Border>
  </Grid>
</Window>
