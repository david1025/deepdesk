<Window x:Class="DeepDesk.ApiKeyDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="配置 DeepSeek API Key" Width="440" Height="270" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#FFFFFF" ShowInTaskbar="False" FontFamily="Microsoft YaHei UI" FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="配置 DeepSeek API Key" FontSize="20" FontWeight="SemiBold" Foreground="#202938"/>
    <TextBlock Grid.Row="1" Text="密钥仅在本机通过 Windows DPAPI 加密保存，不会传给 DeepDesk 服务端。" TextWrapping="Wrap" Foreground="#748094" Margin="0,10,0,16"/>
    <PasswordBox x:Name="KeyBox" Grid.Row="2" Height="40" Padding="10" VerticalContentAlignment="Center"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
      <Button Content="取消" Width="84" Height="34" Margin="0,0,10,0" IsCancel="True"/>
      <Button Content="保存并验证" Width="110" Height="34" Background="#2563EB" Foreground="White" BorderThickness="0" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
