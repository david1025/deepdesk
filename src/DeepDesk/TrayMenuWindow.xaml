<Window x:Class="DeepDesk.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepDesk"
        Width="258" Height="204"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Deactivated="Menu_Deactivated">
  <Window.Resources>
    <SolidColorBrush x:Key="TraySurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TrayBorderBrush" Color="#E7EAF0"/>
    <SolidColorBrush x:Key="TrayTextBrush" Color="#182236"/>
    <SolidColorBrush x:Key="TrayMutedBrush" Color="#8A94A7"/>
    <SolidColorBrush x:Key="TrayHoverBrush" Color="#F1F5FF"/>
    <SolidColorBrush x:Key="TrayDividerBrush" Color="#ECEDF1"/>
    <SolidColorBrush x:Key="TrayDangerBrush" Color="#D73A43"/>
    <SolidColorBrush x:Key="TrayDangerHoverBrush" Color="#FFF0F1"/>
    <Style x:Key="TrayItemStyle" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    CornerRadius="9" Padding="11,0">
              <ContentPresenter VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource TrayHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.80"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TrayExitItemStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource TrayItemStyle}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    CornerRadius="9" Padding="11,0">
              <ContentPresenter VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource TrayDangerHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.80"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="10">
    <Border CornerRadius="15"
            Background="{DynamicResource TraySurfaceBrush}"
            BorderBrush="{DynamicResource TrayBorderBrush}"
            BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3"
                          Direction="270" Opacity="0.18"/>
      </Border.Effect>
      <Grid Margin="11,9,11,9">
        <Grid.RowDefinitions>
          <RowDefinition Height="50"/>
          <RowDefinition Height="1"/>
          <RowDefinition Height="7"/>
          <RowDefinition Height="42"/>
          <RowDefinition Height="4"/>
          <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="6,0,6,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="26"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Image Source="/DeepDesk;component/Assets/deepdesk-logo.png"
                 Width="25" Height="25" Stretch="Uniform" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="DeepDesk" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource TrayTextBrush}"/>
            <TextBlock Text="本地 AI 工作空间" FontSize="10" Margin="0,2,0,0"
                       Foreground="{DynamicResource TrayMutedBrush}"/>
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" Margin="5,0" Background="{DynamicResource TrayDividerBrush}"/>

        <Button Grid.Row="3" x:Name="OpenButton" Style="{StaticResource TrayItemStyle}"
                Click="Open_Click">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="25"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Path Data="M 4,3 H 15 V 14 H 4 Z M 7,6 H 12" Stroke="#446CF3"
                  StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" Width="17" Height="17" Stretch="Uniform"
                  VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <TextBlock Grid.Column="1" Text="打开 DeepDesk" FontWeight="Medium"
                       Foreground="{DynamicResource TrayTextBrush}"
                       VerticalAlignment="Center"/>
          </Grid>
        </Button>
        <Button Grid.Row="5" x:Name="ExitButton" Style="{StaticResource TrayExitItemStyle}"
                Click="Exit_Click">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="25"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Path Data="M 8,2 V 9 M 4.4,4.5 A 6,6 0 1 0 11.6,4.5"
                  Stroke="{DynamicResource TrayDangerBrush}" StrokeThickness="1.7"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="17" Height="17" Stretch="Uniform"
                  HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="退出 DeepDesk" FontWeight="Medium"
                       Foreground="{DynamicResource TrayDangerBrush}"
                       VerticalAlignment="Center"/>
          </Grid>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
