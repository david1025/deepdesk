<Window x:Class="DeepDesk.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepDesk"
        Width="202" Height="110"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        Deactivated="Menu_Deactivated">
  <Window.Resources>
    <SolidColorBrush x:Key="TraySurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TrayBorderBrush" Color="#E9EBEF"/>
    <SolidColorBrush x:Key="TrayTextBrush" Color="#22252B"/>
    <SolidColorBrush x:Key="TrayHoverBrush" Color="#F4F5F7"/>
    <SolidColorBrush x:Key="TrayDividerBrush" Color="#E7E9EC"/>
    <Style x:Key="TrayItemStyle" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TrayTextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,0,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource TrayHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.78"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="5">
    <Border Background="{DynamicResource TraySurfaceBrush}"
            BorderBrush="{DynamicResource TrayBorderBrush}"
            BorderThickness="1" CornerRadius="11">
      <Border.Effect>
        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2"
                          Direction="270" Opacity="0.12"/>
      </Border.Effect>
      <Grid Margin="3">
        <Grid.RowDefinitions>
          <RowDefinition Height="46"/>
          <RowDefinition Height="1"/>
          <RowDefinition Height="46"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Content="打开 DeepDesk"
                Style="{StaticResource TrayItemStyle}" Click="Open_Click"/>
        <Border Grid.Row="1" Background="{DynamicResource TrayDividerBrush}"
                Margin="0"/>
        <Button Grid.Row="2" Content="退出 DeepDesk"
                Style="{StaticResource TrayItemStyle}" Click="Exit_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
