<Window x:Class="DeepDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DeepDesk" Height="820" Width="1280" MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#FFFFFF" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        StateChanged="OnWindowStateChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="TitleBarActionButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource TitleBarHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource TitleBarHoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WindowControlButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Surface" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource TitleBarHoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseWindowControlButton" TargetType="{x:Type Button}" BasedOn="{StaticResource WindowControlButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Surface" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="WindowSurface" BorderThickness="1" BorderBrush="{DynamicResource WindowBorderBrush}"
          CornerRadius="10" ClipToBounds="True"
          Background="{DynamicResource WindowBackgroundBrush}" SizeChanged="WindowSurface_SizeChanged">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border x:Name="TitleBarSurface" Grid.Row="0" CornerRadius="9,9,0,0"
              Background="{DynamicResource TitleBarBackgroundBrush}"
              BorderBrush="{DynamicResource TitleBarBorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="12,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border x:Name="TitleBarIconBorder" Width="16" Height="16" CornerRadius="4"
                  Background="{DynamicResource TitleBarIconBackgroundBrush}"
                  VerticalAlignment="Center">
            <TextBlock x:Name="TitleBarIconText" Text="D" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource TitleBarIconForegroundBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="AboutButton" Content="关于" Style="{StaticResource TitleBarActionButton}"
                    Click="About_Click"/>
            <Button x:Name="CheckForUpdatesButton" Content="检查更新"
                    Style="{StaticResource TitleBarActionButton}" Click="CheckForUpdates_Click"/>
          </StackPanel>

          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="MinimizeButton" Style="{StaticResource WindowControlButton}"
                    Click="Minimize_Click" ToolTip="最小化">
              <TextBlock x:Name="MinimizeGlyph" Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
            </Button>
            <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}"
                    Click="MaximizeRestore_Click" ToolTip="最大化">
              <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
            </Button>
            <Button x:Name="CloseWindowButton" Style="{StaticResource CloseWindowControlButton}"
                    Click="CloseWindow_Click" ToolTip="关闭">
              <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <wv2:WebView2 x:Name="Browser" Visibility="Collapsed"/>
        <Grid x:Name="LoadingPanel" Background="{DynamicResource WindowBackgroundBrush}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
            <TextBlock Text="DeepDesk" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource TitleBarForegroundBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="正在启动本地 AI 工作空间…" Margin="0,10,0,0" FontSize="12"
                       Foreground="{DynamicResource TitleBarMutedBrush}" HorizontalAlignment="Center"/>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,20,0,0"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
