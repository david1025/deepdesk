<Window x:Class="DeepDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DeepDesk" Height="820" Width="1280" MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#FFFFFF" FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        StateChanged="OnWindowStateChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                        GlassFrameThickness="0" UseAeroCaptionButtons="True"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="TitleBarActionButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinWidth" Value="48"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource TitleBarHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource TitleBarHoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <Border x:Name="WindowSurface" BorderThickness="1" BorderBrush="{DynamicResource WindowBorderBrush}"
          CornerRadius="10" ClipToBounds="True"
          Background="{DynamicResource WindowBackgroundBrush}" SizeChanged="WindowSurface_SizeChanged">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border x:Name="TitleBarSurface" Grid.Row="0" CornerRadius="9,9,0,0"
              Background="{DynamicResource TitleBarBackgroundBrush}"
              BorderBrush="{DynamicResource TitleBarBorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="14,0,150,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border x:Name="TitleBarIconBorder" Width="20" Height="20" CornerRadius="5"
                  Background="{DynamicResource TitleBarIconBackgroundBrush}"
                  VerticalAlignment="Center">
            <TextBlock x:Name="TitleBarIconText" Text="D" FontSize="13" FontWeight="Bold"
                       Foreground="{DynamicResource TitleBarIconForegroundBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>

          <TextBlock Grid.Column="1" Text="DeepDesk" Margin="8,0,14,0"
                     FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource TitleBarForegroundBrush}"
                     VerticalAlignment="Center"/>

          <Border Grid.Column="2" Width="1" Height="18" VerticalAlignment="Center"
                  Background="{DynamicResource TitleBarBorderBrush}"/>

          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                      Margin="8,0,0,0">
            <Button x:Name="AboutButton" Content="关于" Style="{StaticResource TitleBarActionButton}"
                    Click="About_Click"/>
            <Button x:Name="CheckForUpdatesButton" Content="检查更新"
                    Style="{StaticResource TitleBarActionButton}" Click="CheckForUpdates_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <wv2:WebView2 x:Name="Browser" Visibility="Collapsed"/>
        <Grid x:Name="LoadingPanel" Background="{DynamicResource WindowBackgroundBrush}">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
            <TextBlock Text="DeepDesk" FontSize="24" FontWeight="SemiBold"
                       Foreground="{DynamicResource TitleBarForegroundBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="正在启动本地 AI 工作空间…" Margin="0,10,0,0" FontSize="12"
                       Foreground="{DynamicResource TitleBarMutedBrush}" HorizontalAlignment="Center"/>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,20,0,0"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
