<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\deepdesk-icon.ico</ApplicationIcon>
    <Version>0.2.0-preview.3</Version>
    <InformationalVersion>0.2.0-preview.3</InformationalVersion>
    <AssemblyName>DeepDesk</AssemblyName>
    <RootNamespace>DeepDesk</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep WinForms references for NotifyIcon, but avoid its implicit global namespace
         leaking into WPF source files (Application, KeyEventArgs, MessageBox, etc.). -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\deepdesk-logo.png" />
    <Resource Include="Assets\deepdesk-icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3856.49" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\chat-ui\dist\**\*">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>