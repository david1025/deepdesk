<Window x:Class="DeepDesk.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepDesk 更新" Icon="/DeepDesk;component/Assets/deepdesk-icon.ico"
        Width="600" Height="288" MinWidth="600" MinHeight="288"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="16"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
  <Window.Resources>
    <Style x:Key="CloseButton" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="#16181D"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="25"/>
      <Setter Property="FontWeight" Value="Light"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#F0F1F3"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#E4E6E9"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ConfirmButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#101114"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="15">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#25272B"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#383B41"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Border Background="#FFFFFF" CornerRadius="30">
      <Border.Effect>
        <DropShadowEffect Color="#000000" BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.20"/>
      </Border.Effect>
      <Grid Margin="36,34,36,36">
        <Grid.RowDefinitions>
          <RowDefinition Height="30"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="66"/>
        </Grid.RowDefinitions>

        <TextBlock Text="DeepDesk" FontSize="22" FontWeight="SemiBold"
                   Foreground="#111318" VerticalAlignment="Center"/>
        <Button Grid.Row="0" Content="×" Style="{StaticResource CloseButton}"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Click="Close_Click" IsCancel="True"/>

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
          <TextBlock x:Name="StatusText" Text="检查更新" FontSize="18" FontWeight="SemiBold"
                     Foreground="#24262B" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="MessageText" Text="" FontSize="14" Foreground="#4A4E57"
                     Margin="0,7,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock x:Name="DetailText" Grid.Row="2" Text="" FontSize="12"
                   Foreground="#858B96" TextWrapping="Wrap" Margin="0,12,0,0"
                   VerticalAlignment="Top"/>
        <Button x:Name="PrimaryButton" Grid.Row="3" Content="确定" Style="{StaticResource ConfirmButton}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Click="Confirm_Click" IsDefault="True"/>
      </Grid>
    </Border>
  </Grid>
</Window>
