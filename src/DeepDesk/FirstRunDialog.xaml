<Window x:Class="DeepDesk.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 DeepDesk"
        Width="640" Height="610"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#172033"/>
    <SolidColorBrush x:Key="Muted" Color="#667085"/>
    <SolidColorBrush x:Key="Line" Color="#E7EAF0"/>
    <SolidColorBrush x:Key="Blue" Color="#315EFB"/>
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#315EFB"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="20,12"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#244DE0"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#1E40C8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="#344054"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D9DEE8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,11"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#F8FAFC"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LinkButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="#315EFB"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="LinkSurface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LinkSurface" Property="Background" Value="#EAF0FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Foreground" Value="#667085"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="CloseSurface" Background="{TemplateBinding Background}" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseSurface" Property="Background" Value="#F2F4F7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Border Background="White" CornerRadius="22" BorderBrush="#E8EBF1" BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect Color="#1B2740" BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.18"/>
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="76"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="88"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#EEF0F4" BorderThickness="0,0,0,1"
                CornerRadius="22,22,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Grid Margin="28,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="40" Height="40" CornerRadius="12" Background="#EEF3FF">
                <TextBlock Text="D" FontSize="23" FontWeight="Bold" Foreground="#315EFB"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="DEEPDESK" FontSize="14" FontWeight="Bold" Foreground="#172033" />
                <TextBlock Text="LOCAL AI WORKSPACE" FontSize="9" FontWeight="SemiBold"
                           Foreground="#98A2B3" Margin="0,3,0,0"/>
              </StackPanel>
            </StackPanel>
            <Button x:Name="CloseButton" Content="×" Style="{StaticResource CloseButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click"/>
          </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="34,24,34,12">
          <TextBlock Text="欢迎使用 DeepDesk" FontSize="27" FontWeight="SemiBold"
                     Foreground="{StaticResource Ink}"/>
          <TextBlock Text="连接你自己的 DeepSeek API，开始使用本地 AI 工作空间。"
                     FontSize="13" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/>

          <Border Background="#F7F9FC" BorderBrush="#EDF0F5" BorderThickness="1"
                  CornerRadius="14" Padding="16" Margin="0,22,0,20">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="9" Background="#E9EFFF" VerticalAlignment="Center">
                  <TextBlock Text="1" Foreground="#315EFB" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="创建 API Key" FontSize="13" FontWeight="SemiBold" Foreground="#273449"/>
                  <TextBlock Text="在 DeepSeek 开放平台创建你的专属密钥" FontSize="11" Foreground="#7B8494" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="前往创建 ↗" Style="{StaticResource LinkButton}"
                        VerticalAlignment="Center" Click="OpenApiPortal_Click"/>
              </Grid>
              <Border Height="1" Background="#E8ECF2" Margin="0,14,0,14"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="9" Background="#E9EFFF" VerticalAlignment="Center">
                  <TextBlock Text="2" Foreground="#315EFB" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="验证并连接" FontSize="13" FontWeight="SemiBold" Foreground="#273449"/>
                  <TextBlock Text="粘贴密钥，验证通过后即可开始对话" FontSize="11" Foreground="#7B8494" Margin="0,3,0,0"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <TextBlock Text="你的 DeepSeek API Key" FontSize="13" FontWeight="SemiBold" Foreground="#344054"/>
          <Border x:Name="KeyBorder" BorderBrush="#D9DEE8" BorderThickness="1"
                  CornerRadius="10" Background="White" Height="48" Margin="0,9,0,0">
            <Grid>
              <PasswordBox x:Name="ApiKeyBox" BorderThickness="0" Background="Transparent"
                           Padding="13,0" FontSize="14" Foreground="#172033"
                           VerticalContentAlignment="Center" PasswordChanged="ApiKeyBox_PasswordChanged"
                           KeyDown="ApiKeyBox_KeyDown"/>
              <TextBlock x:Name="KeyPlaceholder" Text="粘贴 API Key" FontSize="13"
                         Foreground="#A0A8B5" Margin="14,0,0,0" VerticalAlignment="Center"
                         IsHitTestVisible="False"/>
            </Grid>
          </Border>
          <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="#D92D20"
                     Margin="2,8,0,0" TextWrapping="Wrap" MinHeight="17"/>

          <Border Background="#F1F6FF" CornerRadius="10" Padding="12" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="●" Foreground="#315EFB" FontSize="11" Margin="0,2,9,0"/>
              <StackPanel>
                <TextBlock Text="密钥仅在本机加密保存" FontSize="11" FontWeight="SemiBold" Foreground="#344054"/>
                <TextBlock Text="使用 Windows DPAPI 保护，仅当前 Windows 账户可解密。API 调用由你的 DeepSeek 账户直接承担。"
                           FontSize="10" Foreground="#667085" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#EEF0F4" BorderThickness="0,1,0,0"
                CornerRadius="0,0,22,22">
          <Grid Margin="28,0">
            <TextBlock Text="也可以稍后在设置中配置 API Key"
                       FontSize="10" Foreground="#98A2B3" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="SkipButton" Content="稍后配置" Style="{StaticResource SecondaryButton}"
                      Margin="0,0,10,0" Click="Skip_Click"/>
              <Button x:Name="SaveButton" Content="验证并开始使用" Style="{StaticResource PrimaryButton}"
                      IsDefault="True" Click="Save_Click"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
