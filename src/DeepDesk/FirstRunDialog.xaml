<Window x:Class="DeepDesk.FirstRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 DeepDesk"
        Width="700" Height="700" MinWidth="640" MinHeight="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#172033"/>
    <SolidColorBrush x:Key="Muted" Color="#667085"/>
    <SolidColorBrush x:Key="Line" Color="#E7EAF0"/>
    <SolidColorBrush x:Key="Blue" Color="#315EFB"/>

    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#315EFB"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="20,12"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#244DE0"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#1E40C8"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="#344054"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D9DEE8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,11"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#F8FAFC"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="#315EFB"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="LinkSurface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LinkSurface" Property="Background" Value="#EAF0FF"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="{x:Type Button}">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Foreground" Value="#667085"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="CloseSurface" Background="{TemplateBinding Background}" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseSurface" Property="Background" Value="#F2F4F7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <Border Background="White" CornerRadius="22" BorderBrush="#E8EBF1" BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect Color="#1B2740" BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.18"/>
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="72"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="84"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#EEF0F4" BorderThickness="0,0,0,1"
                CornerRadius="22,22,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Grid Margin="28,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="40" Height="40" CornerRadius="12" Background="#EEF3FF">
                <TextBlock Text="D" FontSize="23" FontWeight="Bold" Foreground="#315EFB"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="DEEPDESK" FontSize="14" FontWeight="Bold" Foreground="#172033"/>
                <TextBlock Text="LOCAL AI WORKSPACE" FontSize="9" FontWeight="SemiBold"
                           Foreground="#98A2B3" Margin="0,3,0,0"/>
              </StackPanel>
            </StackPanel>
            <Button x:Name="CloseButton" Content="×" Style="{StaticResource CloseButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click"/>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="38,24,38,24">
            <StackPanel x:Name="StepOnePanel">
              <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="欢迎使用 DeepDesk" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                  <TextBlock Text="连接你自己的 DeepSeek API，开始使用本地 AI 工作空间。"
                             FontSize="13" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="01 / 02" FontSize="11" FontWeight="SemiBold"
                           Foreground="#315EFB" VerticalAlignment="Top" Margin="12,8,0,0"/>
              </Grid>

              <Border Background="#F7F9FC" BorderBrush="#EDF0F5" BorderThickness="1"
                      CornerRadius="14" Padding="16" Margin="0,0,0,20">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Width="30" Height="30" CornerRadius="9" Background="#E9EFFF" VerticalAlignment="Center">
                    <TextBlock Text="1" Foreground="#315EFB" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="创建 API Key" FontSize="13" FontWeight="SemiBold" Foreground="#273449"/>
                    <TextBlock Text="在 DeepSeek 开放平台创建你的专属密钥" FontSize="11" Foreground="#7B8494" Margin="0,3,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="2" Content="前往创建 ↗" Style="{StaticResource LinkButton}"
                          VerticalAlignment="Center" Click="OpenApiPortal_Click"/>
                </Grid>
              </Border>

              <StackPanel x:Name="KeyEntryPanel">
                <TextBlock Text="API Key（可选）" FontSize="13" FontWeight="SemiBold" Foreground="#344054"/>
                <Border x:Name="KeyBorder" BorderBrush="#D9DEE8" BorderThickness="1"
                        CornerRadius="10" Background="White" Height="48" Margin="0,9,0,0">
                  <Grid>
                    <PasswordBox x:Name="ApiKeyBox" BorderThickness="0" Background="Transparent"
                                 Padding="13,0" FontSize="14" Foreground="#172033"
                                 VerticalContentAlignment="Center" PasswordChanged="ApiKeyBox_PasswordChanged"
                                 KeyDown="ApiKeyBox_KeyDown"/>
                    <TextBlock x:Name="KeyPlaceholder" Text="粘贴 API Key（也可以稍后配置）" FontSize="13"
                               Foreground="#A0A8B5" Margin="14,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                  </Grid>
                </Border>
                <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="#D92D20"
                           Margin="2,8,0,0" TextWrapping="Wrap" MinHeight="17"/>
              </StackPanel>

              <Border x:Name="ExistingKeyPanel" Visibility="Collapsed" Background="#F0F7F3"
                      BorderBrush="#D8EBDD" BorderThickness="1" CornerRadius="12" Padding="15">
                <StackPanel>
                  <TextBlock Text="✓  已检测到本机已配置 DeepSeek API Key" FontSize="13"
                             FontWeight="SemiBold" Foreground="#287548"/>
                  <TextBlock Text="无需重复填写，可以直接继续。你也可以稍后在设置中更换密钥。"
                             FontSize="11" Foreground="#5D7567" Margin="0,5,0,0"/>
                </StackPanel>
              </Border>

              <Border Background="#F1F6FF" CornerRadius="10" Padding="13" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="●" Foreground="#315EFB" FontSize="11" Margin="0,2,9,0"/>
                  <StackPanel>
                    <TextBlock Text="密钥仅在本机加密保存" FontSize="11" FontWeight="SemiBold" Foreground="#344054"/>
                    <TextBlock Text="使用 Windows DPAPI 保护。API 调用费用由你的 DeepSeek 账户承担。"
                               FontSize="10" Foreground="#667085" TextWrapping="Wrap" Margin="0,3,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="StepTwoPanel" Visibility="Collapsed">
              <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="导入历史对话" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                  <TextBlock Text="选择 DeepSeek 网页版导出的 ZIP 文件，直接导入到这台电脑。"
                             FontSize="13" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="02 / 02" FontSize="11" FontWeight="SemiBold"
                           Foreground="#315EFB" VerticalAlignment="Top" Margin="12,8,0,0"/>
              </Grid>

              <Border Background="#F8FAFD" BorderBrush="#DCE5F5" BorderThickness="1"
                      CornerRadius="15" Padding="18">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="9" Background="#E9EFFF">
                      <TextBlock Text="1" Foreground="#315EFB" FontWeight="Bold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="选择历史数据文件" FontSize="13" FontWeight="SemiBold" Foreground="#273449"/>
                      <TextBlock Text="支持 DeepSeek 网页版导出的 ZIP 格式" FontSize="11"
                                 Foreground="#7B8494" Margin="0,4,0,0"/>
                    </StackPanel>
                  </Grid>

                  <Border Background="White" BorderBrush="#DCE3EE" BorderThickness="1"
                          CornerRadius="11" Padding="13" Margin="0,15,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Width="30" Height="34" CornerRadius="8" Background="#EEF3FF">
                        <TextBlock Text="ZIP" FontSize="9" FontWeight="Bold" Foreground="#315EFB"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="HistoryFileNameText" Text="尚未选择文件" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#344054" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="HistoryFileMetaText" Text="请选择一个 DeepSeek 历史数据 ZIP 文件"
                                   FontSize="10" Foreground="#98A2B3" Margin="0,3,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Grid Margin="0,13,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="ChooseHistoryFileButton" Content="选择 ZIP 文件…" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Click="ChooseHistoryFile_Click"/>
                    <Button x:Name="ImportHistoryButton" Grid.Column="1" Content="开始导入"
                            Style="{StaticResource PrimaryButton}" IsEnabled="False"
                            Click="ImportHistory_Click"/>
                  </Grid>

                  <ProgressBar x:Name="HistoryProgressBar" Height="5" Minimum="0" Maximum="100"
                               Value="0" Visibility="Collapsed" Margin="0,15,0,0"/>
                  <TextBlock x:Name="HistoryStatusText" Text="" FontSize="11" Foreground="#667085"
                             TextWrapping="Wrap" Margin="1,9,0,0" MinHeight="17"/>
                </StackPanel>
              </Border>

              <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1"
                      CornerRadius="12" Padding="14" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="安全合并导入（推荐）" FontSize="12" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                  <TextBlock Text="导入时会保留本机已有的聊天记录，只添加尚不存在的会话；重复会话自动跳过，不会覆盖现有内容。"
                             FontSize="11" Foreground="#475569" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
              </Border>

              <TextBlock Text="还没有导出的 ZIP？可以先跳过，之后仍可在设置 → 数据管理中导入。"
                         FontSize="10" Foreground="#98A2B3" Margin="2,14,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="#EEF0F4" BorderThickness="0,1,0,0"
                CornerRadius="0,0,22,22">
          <Grid Margin="28,0">
            <TextBlock x:Name="FooterHint" Text="API Key 不是必填项，可以稍后配置。"
                       FontSize="10" Foreground="#98A2B3" VerticalAlignment="Center"/>
            <StackPanel x:Name="StepOneActions" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="SkipButton" Content="暂不配置" Style="{StaticResource SecondaryButton}"
                      Margin="0,0,10,0" Click="Skip_Click"/>
              <Button x:Name="ContinueButton" Content="继续" Style="{StaticResource PrimaryButton}"
                      IsDefault="True" Click="Continue_Click"/>
            </StackPanel>
            <StackPanel x:Name="StepTwoActions" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
              <Button x:Name="BackButton" Content="上一步" Style="{StaticResource SecondaryButton}"
                      Margin="0,0,8,0" Click="Back_Click"/>
              <Button x:Name="SkipImportButton" Content="暂不导入" Style="{StaticResource SecondaryButton}"
                      Margin="0,0,8,0" Click="SkipImport_Click"/>
              <Button x:Name="FinishButton" Content="完成，开始使用" Style="{StaticResource PrimaryButton}"
                      IsEnabled="False" IsDefault="True" Click="Finish_Click"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
